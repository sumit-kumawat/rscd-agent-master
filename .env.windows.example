# RSCD Manager — Windows VM production (UI :80, API :81)
# Copy:  copy .env.windows.example .env
# Deploy: .\scripts\deploy-windows.ps1

COMPOSE_PROJECT_NAME=rscd-agent-master

FRONTEND_PORT=80
BACKEND_PORT=81

NODE_ENV=production
LOG_LEVEL=info
MONGODB_URI=mongodb://mongodb:27017/rscd_agent_master

# Split-port CORS (browser on :80 → API on :81). Add your VM hostname/IP if needed:
# CORS_ORIGIN=http://10.1.2.3,http://myvm.corp.example
CORS_ORIGIN=*

REMOTE_METHODS=wmi
WMIEXEC_PATH=/usr/local/bin/wmiexec.py
# Windows Docker: often leave empty so impacket runs from the container on corp network.
# If WMI hangs in-container, run relay on the Windows host and set:
# WMI_RELAY_URL=http://host.docker.internal:19500
WMI_CONNECT_TIMEOUT_MS=45000
WMI_TIMEOUT_MS=180000
WMI_QUERY_TIMEOUT_MS=30000
WMI_DEFAULT_DOMAIN=CORP
WMI_DNS_SUFFIXES=corp.helixops.ai,bmc.com
RSCD_OS_USERS=rdsroot:YOUR_PASS,rdsmon:YOUR_PASS,Administrator:YOUR_PASS

MONITOR_INTERVAL_SEC=30
MONITOR_CONCURRENCY=30
UNINSTALL_CONCURRENCY=20
OPERATOR_API_KEY=change_me_long_random_operator_key

PROVISION_ON_LOGIN=true
PROVISION_CONCURRENCY=5
