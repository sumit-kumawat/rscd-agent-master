# RSCD Agent Master - Docker Environment
COMPOSE_PROJECT_NAME=rscd-agent-master

# MongoDB
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=password
MONGO_INITDB_DATABASE=rscd_agent_master

# Backend
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_EXPIRE=7d
CORS_ORIGIN=http://localhost

# Seed (run manually: docker compose run --rm backend npm run seed)
SEED_VM_COUNT=500

# VC++ 2015 x64 redistributable (POST /api/system/vcredist-2015/ensure)
# VC_REDIST_2015_X64_URL=https://aka.ms/vs/17/release/vc_redist.x64.exe
# VC_REDIST_2015_X64_LOCAL_PATH=/app/data/prerequisites/vc_redist.x64.exe
# VC_REDIST_CONCURRENCY=5

# Full endpoint inventory sync (backend only — not on browser refresh)
# SYNC_INTERVAL_HOURS=3
# ENDPOINT_SYNC_DISABLED=true

# Lightweight connectivity monitor (separate from full sync)
# CONNECTIVITY_CHECK_INTERVAL_SECONDS=30

# Optional: queue local-user provision job on login (default off)
# PROVISION_ON_LOGIN=true

# Background WMI agent version probes (after monitor marks host online)
# BACKGROUND_AGENT_INVENTORY=false
# BACKGROUND_INVENTORY_CONCURRENCY=2
# BACKGROUND_INVENTORY_MIN_AGE_MS=10800000
