# RSCD Agent Master - Docker Environment
COMPOSE_PROJECT_NAME=rscd-agent-master

# MongoDB
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=password
MONGO_INITDB_DATABASE=rscd_agent_master

# Backend
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_EXPIRE=7d
CORS_ORIGIN=http://localhost

# Seed (run manually: docker compose run --rm backend npm run seed)
SEED_VM_COUNT=500
