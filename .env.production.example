# RSCD Manager — Production environment
# Copy to .env and set real values before deploy:
#   cp .env.production.example .env

COMPOSE_PROJECT_NAME=rscd-agent-master

# App
NODE_ENV=production
PORT=5000
APP_PORT=8080
LOG_LEVEL=info

# MongoDB (internal Docker network — no auth by default)
MONGODB_URI=mongodb://mongodb:27017/rscd_agent_master

# Optional MongoDB auth (uncomment both + update MONGODB_URI)
# MONGO_ROOT_USER=rscd_admin
# MONGO_ROOT_PASSWORD=change_me_strong_password
# MONGODB_URI=mongodb://rscd_admin:change_me_strong_password@mongodb:27017/rscd_agent_master?authSource=admin

# WMI / remote operations
REMOTE_METHODS=wmi
WMIEXEC_PATH=/usr/local/bin/wmiexec.py
WMI_TIMEOUT_MS=90000
WMI_CONNECT_TIMEOUT_MS=20000
WMI_MAX_ATTEMPTS=12
WMI_SESSION_CACHE_MS=600000
DNS_CACHE_TTL_MS=300000
WMI_DEFAULT_DOMAIN=CORP
WMI_DNS_SUFFIXES=corp.helixops.ai,bmc.com

# OS credentials for WMI (comma-separated user:password)
RSCD_OS_USERS=rdsroot:YOUR_PASSWORD,rdsmon:YOUR_PASSWORD,Administrator:YOUR_PASSWORD

# Monitor & jobs
MONITOR_INTERVAL_SEC=30
MONITOR_CONCURRENCY=30
UNINSTALL_CONCURRENCY=20
UNINSTALL_BELOW_VERSION=22.4.00

# Security — strongly recommended in production
# Destructive API actions (uninstall, delete, cancel) require this header:
#   X-Operator-Key: <your-key>
OPERATOR_API_KEY=change_me_long_random_operator_key

# CORS (set to your public URL if fronted by another host)
CORS_ORIGIN=*
