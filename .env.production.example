# RSCD Manager — Production environment
# Copy to .env and set real values before deploy:
#   cp .env.production.example .env

COMPOSE_PROJECT_NAME=rscd-agent-master

# App
NODE_ENV=production
PORT=5000
APP_PORT=8080
LOG_LEVEL=info

# MongoDB (internal Docker network — no auth by default)
MONGODB_URI=mongodb://mongodb:27017/rscd_agent_master

# Optional MongoDB auth (uncomment both + update MONGODB_URI)
# MONGO_ROOT_USER=rscd_admin
# MONGO_ROOT_PASSWORD=change_me_strong_password
# MONGODB_URI=mongodb://rscd_admin:change_me_strong_password@mongodb:27017/rscd_agent_master?authSource=admin

# WMI / remote operations
REMOTE_METHODS=wmi
WMIEXEC_PATH=/usr/local/bin/wmiexec.py
# Mac Docker: relay on host. Linux on corp network: leave empty.
# WMI_RELAY_URL=http://host.docker.internal:19500
# WMI_RELAY_PORT=19500
WMI_TIMEOUT_MS=180000
# Use 45000+ when WMI_RELAY_URL is set (host DCOM can be slower than Docker SMB)
WMI_CONNECT_TIMEOUT_MS=45000
WMI_OUTPUT_WAIT_SEC=120
WMI_POLL_INTERVAL_MS=10000
# Per-step uninstall timeouts (ms)
WMI_STEP_DETECT_MS=120000
WMI_STEP_STOP_MS=90000
WMI_STEP_MSI_MS=300000
WMI_STEP_REGISTRY_MS=120000
WMI_STEP_DIRECTORY_MS=180000
WMI_STEP_VERIFY_MS=90000
WMI_STEP_CMD_MS=60000
MONITOR_PROBE_BACKOFF_SEC=90
WMI_SESSION_CACHE_MS=600000
DNS_CACHE_TTL_MS=300000
WMI_DEFAULT_DOMAIN=CORP
WMI_DNS_SUFFIXES=corp.helixops.ai,bmc.com

# OS credentials for WMI — tried in order on auth failure (no domain permutation).
# Defaults built-in if unset: rdsroot, rdsmon, Administrator (bmcAdm1n), Administrator (#D3Pl0y_M3nT$)
# Format: user:password or DOMAIN\user:password (comma-separated)
RSCD_OS_USERS=rdsroot:YOUR_RDSROOT_PASSWORD,rdsmon:YOUR_RDSMON_PASSWORD,Administrator:bmcAdm1n,Administrator:#D3Pl0y_M3nT$
MONITOR_LIGHTWEIGHT_PROBE=true
WMI_AGENT_INVENTORY_TIMEOUT_MS=60000
STARTUP_VM_CHECK=true
BACKGROUND_AGENT_INVENTORY=true

# Monitor & jobs
MONITOR_INTERVAL_SEC=30
MONITOR_CONCURRENCY=30
UNINSTALL_CONCURRENCY=20
UNINSTALL_BELOW_VERSION=22.4.00

# Security — strongly recommended in production
# Destructive API actions (uninstall, delete, cancel) require this header:
#   X-Operator-Key: <your-key>
OPERATOR_API_KEY=change_me_long_random_operator_key

# CORS (set to your public URL if fronted by another host)
CORS_ORIGIN=*
